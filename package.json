  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./shadcn": {
      "import": "./dist/shadcn.mjs",
      "require": "./dist/shadcn.js"
    }
  },
  "files": [
